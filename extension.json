{
  "manifest_version": 2,
  "name": "ArticleGeolocation",
  "version": "0.1.0-dev",
  "author": [
    "FiocruzLivre"
  ],
  "license-name": "AGPL-3.0-or-later",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.46.0"
  },
  "AvailableRights": ["articlegeolocation-review"],
  "GroupPermissions": {
    "sysop": {
      "articlegeolocation-review": true
    }
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\ArticleGeolocation\\": "src/"
  },
  "Hooks": {
    "ParserFirstCallInit": "mapEmbed",
    "SkinTemplateNavigation::Universal": "locationNavigation",
    "PageSaveComplete": "notification",
    "BeforeCreateEchoEvent": "notification"
  },
  "HookHandlers": {
    "notification": {
      "class": "MediaWiki\\Extension\\ArticleGeolocation\\NotificationHooks"
    },
    "mapEmbed": {
      "class": "MediaWiki\\Extension\\ArticleGeolocation\\MapEmbedHooks"
    },
    "locationNavigation": {
      "class": "MediaWiki\\Extension\\ArticleGeolocation\\LocationNavigationHooks"
    }
  },
  "DefaultUserOptions": {
    "echo-subscriptions-web-article-geolocation": true,
    "echo-subscriptions-email-article-geolocation": false
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "ArticleGeolocation"
  },
  "ResourceModules": {
    "ext.articleGeolocation.map": {
      "styles": [
        "resources/map.css"
      ]
    },
    "ext.articleGeolocation.locationEditor": {
      "scripts": ["resources/location-editor.js"],
      "styles": ["resources/location-editor.css"],
      "dependencies": ["ext.pageforms.leaflet"],
      "targets": ["desktop", "mobile"]
    },
    "ext.articleGeolocation.review": {
      "scripts": [
        "resources/review.js"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    }
  },
  "SpecialPages": {
    "ArticleGeolocationFeed": "MediaWiki\\Extension\\ArticleGeolocation\\SpecialGeoJson",
    "ArticleGeolocationReview": "MediaWiki\\Extension\\ArticleGeolocation\\SpecialReview",
    "ArticleGeolocationPreview": "MediaWiki\\Extension\\ArticleGeolocation\\SpecialMapPreview",
    "ArticleGeolocationEdit": "MediaWiki\\Extension\\ArticleGeolocation\\SpecialLocationEdit"
  },
  "MessagesDirs": {
    "ArticleGeolocation": [
      "i18n"
    ]
  }
}
